#!/bin/sh
set -eu

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
case "$(uname -s):$(uname -m)" in
  Darwin:x86_64) binary="polymarket-mcp-rs-macos-x86_64" ;;
  Darwin:arm64) binary="polymarket-mcp-rs-macos-aarch64" ;;
  Linux:x86_64|Linux:amd64) binary="polymarket-mcp-rs-linux-x86_64" ;;
  Linux:aarch64|Linux:arm64) binary="polymarket-mcp-rs-linux-aarch64" ;;
  *) echo "unsupported platform: $(uname -s) $(uname -m)" >&2; exit 1 ;;
esac
exec "${script_dir}/${binary}" "$@"
